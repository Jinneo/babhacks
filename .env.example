# Local proposal-only API. Generate a long random value; never commit .env.
PROPOSAL_API_TOKEN=

# Local CLI used for web research on every Strategy Lab submission.
RESEARCH_AGENT_BIN=/absolute/path/to/local-research-agent

# Optional x402 test-payment settlement on Base Sepolia. Keep the private key
# only in ignored .env, and fund the relayer with Base Sepolia ETH for gas.
BASE_SEPOLIA_RPC=https://sepolia.base.org
RELAYER_PRIVATE_KEY=
